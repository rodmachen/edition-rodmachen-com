{
  "redirects": [
    {
      "source": "/p/:slug",
      "destination": "/newsletter/:slug/",
      "permanent": true
    },
    {
      "source": "/blog/",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/categories/:path*/",
      "destination": "/topics/:path*/",
      "permanent": true
    },
    {
      "source": "/categories/:path*",
      "destination": "/topics/:path*",
      "permanent": true
    },
    {
      "source": "/article/:path*",
      "destination": "/articles/:path*",
      "permanent": true
    },
    {
      "source": "/review/:path*",
      "destination": "/reviews/:path*",
      "permanent": true
    },
    {
      "source": "/essay/:path*",
      "destination": "/articles/:path*",
      "permanent": true
    },
    {
      "source": "/byline/:path*",
      "destination": "/bylines/:path*",
      "permanent": true
    }
  ]
}
