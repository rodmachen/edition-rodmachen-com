---
import type { ListItem } from '../utils/posts';
import { formatDate } from '../utils/posts';

interface Props {
  items: ListItem[];
  showTags?: boolean;
}

const { items, showTags = true } = Astro.props;
---

<ul class="catalog">
  {items.map((item) => {
    const date = formatDate(item.date);
    return (
      <li>
        <time>{date}</time>
        <div class="entry-body">
          <div class="entry-title-row">
            {item.type === 'byline' ? (
              <>
                <a href={item.href} target="_blank" rel="noopener">{item.title}</a>
                <span class="entry-pub">&middot; {item.publication}</span>
              </>
            ) : (
              <a href={item.href}>{item.title}</a>
            )}
          </div>
          {item.subtitle && <div class="entry-dek">{item.subtitle}</div>}
          {showTags && item.tags && item.tags.length > 0 && (
            <div class="entry-tags">
              {item.tags.map((tag) => (
                <a href={`/topics/${tag}/`} class="tag">{tag}</a>
              ))}
            </div>
          )}
        </div>
      </li>
    );
  })}
</ul>

<style>
  .catalog {
    list-style: none;
    margin-bottom: 2.5rem;
    border-top: 2px solid var(--ink);
  }

  .catalog li {
    display: flex;
    gap: 1.25rem;
    align-items: baseline;
    padding: 0.65rem 0;
    border-bottom: var(--rule-thin) solid var(--rule-soft);
  }

  .catalog time {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--gold);
    letter-spacing: 0.04em;
    white-space: nowrap;
    min-width: 5.5rem;
    padding-top: 0.1rem;
  }

  .entry-body {
    flex: 1;
    min-width: 0;
  }

  .entry-title-row {
    display: flex;
    gap: 0.5rem;
    align-items: baseline;
    flex-wrap: wrap;
  }

  .entry-title-row a {
    font-family: var(--font-text);
    font-weight: 600;
    font-size: var(--text-base);
    color: var(--ink);
    line-height: 1.25;
    letter-spacing: -0.005em;
    text-decoration: none;
  }

  .entry-title-row a:hover {
    color: var(--accent);
    text-decoration: none;
  }

  .entry-pub {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--ink-soft);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .entry-dek {
    font-size: 0.875rem;
    color: var(--ink-soft);
    font-style: italic;
    margin-top: 0.15rem;
  }

  .entry-tags {
    display: flex;
    gap: 0.4rem;
    flex-wrap: wrap;
    margin-top: 0.25rem;
  }

  .tag {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--ink-soft);
    text-decoration: none;
    letter-spacing: 0.04em;
  }

  .tag:hover {
    color: var(--accent);
  }

  @media (max-width: 500px) {
    .catalog li {
      flex-direction: column;
      gap: 0.1rem;
    }

    .catalog time {
      min-width: auto;
    }
  }
</style>
