---
import type { ListItem } from '../utils/posts';
import { formatDate, CATEGORY_CONFIG } from '../utils/posts';
import { CldImage } from 'astro-cloudinary';

interface Props {
  items: ListItem[];
}

const { items } = Astro.props;

function isCloudinaryUrl(url: string | undefined): boolean {
  return !!url && /res\.cloudinary\.com/.test(url);
}

const ACCENT_VARS: Record<string, string> = {
  newsletter: 'var(--accent-newsletter)',
  article: 'var(--accent-articles)',
  review: 'var(--accent-reviews)',
  byline: 'var(--accent-bylines)',
};
---

<ul class="catalog">
  {items.map((item) => {
    const date = formatDate(item.date);
    const catConfig = item.category ? CATEGORY_CONFIG[item.category] : null;
    const accentVar = ACCENT_VARS[item.category || ''] ?? 'var(--accent)';
    return (
      <li class="catalog-entry" style={`--item-accent: ${accentVar}`}>
        <time class="entry-date">{date}</time>
        <div class="entry-body">
          {item.image && (
            <div class="entry-logo">
              {isCloudinaryUrl(item.image) ? (
                <CldImage src={item.image} alt="" width={48} height={48} crop="fill" gravity="auto" class="logo-img" loading="lazy" />
              ) : (
                <img src={item.image} alt="" class="logo-img" loading="lazy" />
              )}
            </div>
          )}
          <div class="entry-meta">
            {catConfig && <span class="entry-cat">{catConfig.label}</span>}
            {item.type === 'byline' && item.publication && (
              <span class="entry-pub">{item.publication}</span>
            )}
          </div>
          <a href={item.href} class="entry-link" {...(item.type === 'byline' ? { target: '_blank', rel: 'noopener' } : {})}>
            <span class="entry-title">{item.title}</span>
          </a>
          {item.subtitle && <p class="entry-dek">{item.subtitle}</p>}
          {item.tags && item.tags.length > 0 && (
            <div class="entry-tags">
              {item.tags.map((tag) => (
                <a href={`/topics/${tag}/`} class="tag">{tag}</a>
              ))}
            </div>
          )}
        </div>
      </li>
    );
  })}
</ul>

<style>
  .catalog {
    list-style: none;
    margin-bottom: 2.5rem;
    border-top: 2px solid var(--ink);
  }

  .catalog-entry {
    display: grid;
    grid-template-columns: 5.5rem 1fr;
    gap: 0 0.85rem;
    padding: 0.75rem 0;
    border-bottom: var(--rule-thin) solid var(--rule-soft);
    align-items: start;
  }

  .entry-date {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--gold);
    letter-spacing: 0.04em;
    white-space: nowrap;
    padding-top: 0.3rem;
  }

  .entry-body {
    min-width: 0;
  }

  .entry-logo {
    float: right;
    margin: 0 0 0.5rem 0.75rem;
  }

  .logo-img {
    width: 2.5rem;
    height: 2.5rem;
    object-fit: contain;
    border-radius: 3px;
    opacity: 0.85;
  }

  .entry-meta {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--ink-soft);
    margin-bottom: 0.2rem;
  }

  .entry-cat {
    color: var(--item-accent);
  }

  .entry-pub {
    color: var(--ink-soft);
  }

  .entry-link {
    display: block;
    text-decoration: none;
  }

  .entry-title {
    font-family: var(--font-text);
    font-weight: 600;
    font-size: var(--text-base);
    color: var(--ink);
    line-height: 1.25;
    letter-spacing: -0.005em;
  }

  .entry-link:hover .entry-title {
    color: var(--item-accent);
  }

  .entry-dek {
    font-size: 0.875rem;
    font-style: italic;
    color: var(--ink-soft);
    margin: 0.3rem 0 0;
    line-height: 1.4;
  }

  .entry-tags {
    display: flex;
    gap: 0.4rem;
    flex-wrap: wrap;
    margin-top: 0.3rem;
  }

  .tag {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--ink-soft);
    text-decoration: none;
    letter-spacing: 0.04em;
  }

  .tag:hover {
    color: var(--item-accent);
  }

  @media (max-width: 500px) {
    .catalog-entry {
      grid-template-columns: 4.5rem 1fr;
      gap: 0 0.5rem;
    }
  }
</style>
