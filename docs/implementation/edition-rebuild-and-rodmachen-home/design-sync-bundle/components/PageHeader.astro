---
interface Props {
  title: string;
  subtitle?: string;
  count?: number;
  countLabel?: string;
  titleColor?: string;
}

const { title, subtitle, count, countLabel = 'post', titleColor } = Astro.props;
---

<header class="page-header">
  <h1 style={titleColor ? `color: ${titleColor}` : undefined}>{title}</h1>
  {subtitle && <p class="page-subtitle">{subtitle}</p>}
  {count !== undefined && (
    <p class="page-count">{count} {countLabel}{count !== 1 ? 's' : ''}</p>
  )}
</header>

<style>
  .page-header {
    text-align: center;
    padding: 2rem 0 1.5rem;
    border-bottom: 2px solid var(--ink);
    margin-bottom: 2rem;
  }

  .page-header h1 {
    font-family: var(--font-display);
    font-size: clamp(2rem, 6vw, 3rem);
    font-weight: 400;
    letter-spacing: -0.01em;
    margin-bottom: 0.35rem;
  }

  .page-subtitle {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--ink-soft);
    text-transform: uppercase;
    letter-spacing: var(--tracking-mono);
  }

  .page-count {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--gold);
    text-transform: uppercase;
    letter-spacing: var(--tracking-mono);
    margin-top: 0.25rem;
  }
</style>
